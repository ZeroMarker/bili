[Unit]
Description=Bili 推流管理 WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=-%h/.config/bili/webui.env
ExecStart=@PROJECT_ROOT@/webui/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@PROJECT_ROOT@ %h/.config/bili

[Install]
WantedBy=default.target
