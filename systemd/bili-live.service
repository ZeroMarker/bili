[Unit]
Description=Bili 直播推流 push.sh（TikTok 直播源 -> Bilibili）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=%h/.config/bili/live.env
ExecStart=@PROJECT_ROOT@/push.sh $TARGET
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@PROJECT_ROOT@/logs

[Install]
WantedBy=default.target
